{
  "name": "dyslexiabuddy-social-video",
  "version": "1.0.0",
  "description": "DyslexiaBuddy social video templates",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "render": "remotion render src/index.ts PhaseOneTwoRelease out/phase-one-two-release.mp4 --image-format=jpeg --jpeg-quality=85 --concurrency=2",
    "render:intro": "remotion render src/index.ts DyslexiaBuddyIntro out/dyslexiabuddy-intro.mp4",
    "still": "remotion still src/index.ts PhaseOneTwoRelease out/phase-one-two-release-cover.png --frame=840",
    "still:intro": "remotion still src/index.ts DyslexiaBuddyIntro out/dyslexiabuddy-intro-cover.png --frame=150",
    "lint": "eslint src && tsc",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@remotion/captions": "4.0.488",
    "@remotion/cli": "4.0.488",
    "@remotion/eslint-plugin": "4.0.488",
    "@remotion/media": "4.0.488",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.488"
  },
  "devDependencies": {
    "@eslint/js": "9.19.0",
    "@remotion/eslint-config-flat": "4.0.488",
    "@types/react": "19.2.7",
    "eslint": "9.19.0",
    "eslint-plugin-react": "7.37.4",
    "eslint-plugin-react-hooks": "5.2.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "sideEffects": [
    "*.css"
  ]
}
